# Copy to a private env file on the H100 VM. Never commit the API key.
H100_EVAL_API_KEY=
H100_EVAL_MODEL=Qwen/Qwen3.8-27B
H100_EVAL_IMAGE=vllm/vllm-openai:v0.17.0
H100_EVAL_MAX_MODEL_LEN=262144
H100_EVAL_GPU_MEMORY_UTILIZATION=0.85
H100_EVAL_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
H100_EVAL_RERANKER_MODEL=BAAI/bge-reranker-base
H100_EVAL_TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:hopper-1.9
HF_CACHE_DIR=/mnt/vllm-cache/huggingface
