[Unit]
Description=India Alternatives T4 inference services
Wants=network-online.target
Requires=docker.service
After=network-online.target docker.service nvidia-persistenced.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=__REPO_DIR__
ExecStartPre=__DOCKER_BIN__ info
ExecStart=__DOCKER_BIN__ compose --env-file __ENV_FILE__ -f __COMPOSE_FILE__ up -d --remove-orphans
ExecReload=__DOCKER_BIN__ compose --env-file __ENV_FILE__ -f __COMPOSE_FILE__ up -d --remove-orphans
ExecStop=__DOCKER_BIN__ compose --env-file __ENV_FILE__ -f __COMPOSE_FILE__ stop
TimeoutStartSec=0
TimeoutStopSec=300
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
