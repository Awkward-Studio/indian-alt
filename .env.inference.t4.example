# T4 inference VM environment for docker-compose.inference.t4.yml
#
# Usage:
#   cp .env.inference.t4.example .env.inference.t4
#   edit .env.inference.t4
#   docker compose --env-file .env.inference.t4 -f docker-compose.inference.t4.yml up -d
#
# Enable the same stack at every VM boot after the first successful setup. The
# VM stores the compose and environment files in the login user's home folder:
#   sudo ./scripts/install_t4_inference_autostart.sh
# or:
#   sudo ./autostart_script.sh
# When invoked with sudo, the installer resolves SUDO_USER rather than /root,
# so user awkwardstudio resolves to /home/awkwardstudio. Override this only when
# needed with T4_INFERENCE_DIR=/another/path.
#
# Django app settings should point at the VM. Gemma 4 handles text, planning,
# and image transcription. Document processing is intentionally excluded from
# this compose stack until the standalone docproc service is reintroduced:
#   VLLM_BASE_URL=http://YOUR_T4_VM_IP:8000/v1
#   VLLM_TEXT_MODEL=<same as VLLM_TEXT_MODEL below>
#   VLLM_PLANNER_MODEL=<same as VLLM_TEXT_MODEL below>
#   EMBEDDING_BASE_URL=http://YOUR_T4_VM_IP:8081/v1
#   EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
#   RERANKER_BASE_URL=http://YOUR_T4_VM_IP:8082
#   RERANKER_MODEL=BAAI/bge-reranker-base

# Shared cache
HF_TOKEN=
HF_CACHE_DIR=/mnt/vllm-cache/huggingface

# Gemma 4 text/planner server. vLLM's Gemma 4 attention kernel exceeds Turing's
# shared-memory limit, so this T4 profile uses a Q8_0 GGUF through
# llama.cpp's OpenAI-compatible server instead.
VLLM_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
VLLM_API_KEY=local-dev-key
VLLM_PORT=8000
VLLM_TEXT_MODEL=gemma-4-12b-it-q8
LLAMA_MODEL_SOURCE=bartowski/gemma-4-12B-it-GGUF:Q8_0
LLAMA_CONTEXT_SIZE=16384
LLAMA_PARALLEL_SEQUENCES=1
LLAMA_GPU_LAYERS=99
LLAMA_BATCH_SIZE=2048
LLAMA_UBATCH_SIZE=512
LLAMA_CACHE_TYPE_K=q8_0
LLAMA_CACHE_TYPE_V=q8_0
LLAMA_IMAGE_MAX_TOKENS=1120
# 3=info, 4=trace, 5=debug. Trace makes model loading and GPU setup visible.
LLAMA_LOG_VERBOSITY=4
NVIDIA_VISIBLE_DEVICES=all

# T4 is a Turing GPU. Both small TEI services share it with vLLM.
TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:turing-1.9.3
TEI_DTYPE=float16
# Avoid TEI's CUDA 12.9 compatibility library on CUDA 13.x hosts. The NVIDIA
# container runtime injects the matching host driver under /usr/local/nvidia.
TEI_LD_LIBRARY_PATH=/usr/local/nvidia/lib:/usr/local/nvidia/lib64:/usr/local/cuda/lib64

EMBEDDING_PORT=8081
EMBEDDING_MODEL_ID=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_MAX_BATCH_TOKENS=2048
EMBEDDING_MAX_BATCH_REQUESTS=1
EMBEDDING_MAX_CLIENT_BATCH_SIZE=8

RERANKER_PORT=8082
RERANKER_MODEL_ID=BAAI/bge-reranker-base
RERANKER_MAX_BATCH_TOKENS=2048
